<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <%- include("../navbar", { links: links }) %>

    <main>
      <h1><%= title %></h1>
      <p>Browse the current users and their details.</p>

      <%- include("searchForm", { query: { name: "", email: "" } }) %>

      <% if (users.length === 0) { %>
        <p>No users found.</p>
      <% } %>

      <ul>
        <% users.forEach((user) => { %>
          <%- include("user", { user: user }) %>
        <% }); %>
      </ul>
    </main>
  </body>
</html>
