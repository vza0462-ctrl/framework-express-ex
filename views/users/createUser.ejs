<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <%- include("../navbar", { links: links }) %>

    <main>
      <h1><%= title %></h1>

      <%- include("searchForm", {
        query: { name: "", email: "" },
      }) %>

      <% if (errors.length > 0) { %>
        <section>
          <h2>Validation Errors</h2>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <form method="POST" action="/users">
        <div>
          <label for="name">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            value="<%= values.name %>"
            required
          />
        </div>

        <div>
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            value="<%= values.email %>"
            required
          />
        </div>

        <div>
          <label for="age">Age</label>
          <input
            id="age"
            name="age"
            type="number"
            min="18"
            max="120"
            step="1"
            value="<%= values.age %>"
          />
        </div>

        <div>
          <label for="bio">Bio</label>
          <textarea id="bio" name="bio" rows="4" cols="40" maxlength="200"><%= values.bio %></textarea>
        </div>

        <button type="submit">Create User</button>
      </form>
    </main>
  </body>
</html>
