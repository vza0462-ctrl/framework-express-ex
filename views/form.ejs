<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <%- include("navbar", { links: links }) %>

    <main>
      <h1><%= title %></h1>

      <form method="POST" action="/new">
        <div>
          <label for="messageUser">Author</label>
          <input
            id="messageUser"
            name="messageUser"
            type="text"
            required
          />
        </div>

        <div>
          <label for="messageText">Message</label>
          <textarea
            id="messageText"
            name="messageText"
            rows="4"
            cols="40"
            required
          ></textarea>
        </div>

        <button type="submit">Send message</button>
      </form>
    </main>
  </body>
</html>
