<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
  </head>
  <body>
    <%- include("navbar", { links: links }) %>

    <main>
      <h1><%= title %></h1>
      <p>Welcome to the mini message board.</p>

      <% if (messages.length === 0) { %>
        <p>No messages yet.</p>
      <% } %>

      <ul>
        <% messages.forEach((message, index) => { %>
          <li>
            <p><strong><%= message.user %></strong></p>
            <p><%= message.text %></p>
            <p><%= message.added.toLocaleString() %></p>
            <a href="/messages/<%= index %>">Open</a>
          </li>
        <% }); %>
      </ul>
    </main>
  </body>
</html>
